NODE_ENV=development
PORT=4000
API_ORIGIN=http://localhost:4000
WEB_ORIGIN=http://localhost:3000

# Clerk
CLERK_SECRET_KEY=sk_test_replace_me

# Supabase Postgres / Prisma
# Use a direct or Supavisor session-mode URL for the persistent Express server.
DATABASE_URL=postgresql://postgres:password@db.project.supabase.co:5432/postgres?sslmode=require
# Optional separate URL for Prisma CLI migrations.
DIRECT_URL=postgresql://postgres:password@db.project.supabase.co:5432/postgres?sslmode=require

# Wallet data provider: Alchemy is preferred if it covers the required Base/Solana capabilities.
ALCHEMY_BASE_API_URL=https://base-mainnet.g.alchemy.com/v2/<API_KEY>
ALCHEMY_API_KEY=
ALCHEMY_SOLANA_API_URL=
# Legacy adapter kept until the provider decision is finalized.
BLOCKSCOUT_BASE_API_URL=https://base.blockscout.com/api/v2
BLOCKSCOUT_SOLANA_API_URL=

# Cloudflare R2 (added when upload routes are enabled)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# Gemini (added when AI jobs are enabled)
GEMINI_API_KEY=

# Resend monthly tax reminders
RESEND_API_KEY=
RESEND_FROM_EMAIL=finance@example.com

# Composio (added when provider connections are enabled)
COMPOSIO_API_KEY=
# Optional: pin a specific auth-config ID (e.g. ac_xxxxxxxx) per toolkit from
# https://app.composio.dev → Toolkit → Auth configs. When unset, the API uses
# the enabled auth config Composio already has for that toolkit, so a config
# created in the dashboard works with no extra setup. Restart to reload .env.
COMPOSIO_AUTH_CONFIG_GMAIL=
COMPOSIO_AUTH_CONFIG_OUTLOOK=
# Optional: where Composio sends the user's browser after OAuth completes
# (?status=success|failed). Point it at a page on the web origin, e.g.
# http://localhost:3000/callback locally. Leave unset to use Composio's default.
COMPOSIO_CALLBACK_URL=
