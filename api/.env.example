NODE_ENV=development
PORT=4000
API_ORIGIN=http://localhost:4000
WEB_ORIGIN=http://localhost:3000

# Clerk
CLERK_SECRET_KEY=sk_test_replace_me

# Supabase Postgres / Prisma
# Use a direct or Supavisor session-mode URL for the persistent Express server.
DATABASE_URL=postgresql://postgres:password@db.project.supabase.co:5432/postgres?sslmode=require
# Optional separate URL for Prisma CLI migrations.
DIRECT_URL=postgresql://postgres:password@db.project.supabase.co:5432/postgres?sslmode=require

# Wallet data provider: Alchemy is preferred if it covers the required Base/Solana capabilities.
# Each chain has its own endpoint; set one without the other and that chain falls
# back to Blockscout (Base only) or reports provider_unconfigured (Solana).
ALCHEMY_BASE_API_URL=https://base-mainnet.g.alchemy.com/v2/<API_KEY>
ALCHEMY_API_KEY=
ALCHEMY_SOLANA_API_URL=https://solana-mainnet.g.alchemy.com/v2/<API_KEY>
# Legacy adapter kept until the provider decision is finalized.
BLOCKSCOUT_BASE_API_URL=https://base.blockscout.com/api/v2
BLOCKSCOUT_SOLANA_API_URL=

# Cloudflare R2 (added when upload routes are enabled)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# Gemini (added when AI jobs are enabled)
GEMINI_API_KEY=

# Resend monthly tax reminders
RESEND_API_KEY=
# Must be on a domain verified at https://resend.com/domains (apex domains need
# their own SPF/DKIM records — subdomains like dobby.riftlabs.xyz verify
# separately). Unverified senders fall back to onboarding@resend.dev.
RESEND_FROM_EMAIL=finance@example.com

# Composio (added when provider connections are enabled)
COMPOSIO_API_KEY=
# Optional: pin a specific auth-config ID (e.g. ac_xxxxxxxx) per toolkit from
# https://app.composio.dev → Toolkit → Auth configs. When unset, the API uses
# the enabled auth config Composio already has for that toolkit, so a config
# created in the dashboard works with no extra setup. Restart to reload .env.
COMPOSIO_AUTH_CONFIG_GMAIL=
COMPOSIO_AUTH_CONFIG_OUTLOOK=
# Optional: where Composio sends the user's browser after OAuth completes
# (?status=success|failed). Point it at a page on the web origin, e.g.
# http://localhost:3000/callback locally. Leave unset to use Composio's default.
COMPOSIO_CALLBACK_URL=

# Bachs (Pro plan checkout + webhooks)
# Sandbox key from https://app.bachs.io → developer section (sk_sandbox_...).
BACHS_API_KEY=
# Signing secret shown on the webhook endpoint that points at POST /v1/billing/webhook.
BACHS_WEBHOOK_SECRET=
# Recurring catalog product that Dobby Pro subscribers buy (prod_...).
BACHS_PRO_PRODUCT_ID=
# Yearly cadence sibling of the monthly product, offered next to it at checkout.
BACHS_PRO_YEARLY_PRODUCT_ID=


# Postgres pool (Supavisor/pgbouncer): applied only when the URL omits them.
# The API default is connection_limit=20, pool_timeout=30, connect_timeout=10.
# DATABASE_URL=postgresql://...?pgbouncer=true&connection_limit=20&pool_timeout=30

# Error monitoring. Unset means Sentry is never initialised and the API behaves
# exactly as before. Identity is not attached, request bodies are not captured,
# and everything that is sent is scrubbed in src/lib/sentry.ts (amounts, emails,
# merchants, tax figures, wallet addresses and all API keys are dropped).
SENTRY_DSN=
# Performance/trace sampling. 0 keeps Sentry to error reports only, which is the
# right default here — traces carry request paths and timings.
SENTRY_TRACES_SAMPLE_RATE=0
