generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TransferDirection {
  IN
  OUT
}

enum AccountType {
  BANK
  CASH
  CREDIT_CARD
  WALLET
  INVESTMENT
  OTHER
}

enum Chain {
  BASE
  SOLANA
}

enum WalletValidationStatus {
  PENDING
  VERIFIED
  FAILED
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum ImportType {
  CSV
  OFX
  QFX
  RECEIPT
}

enum ImportStatus {
  CREATED
  PROCESSING
  REVIEW
  COMPLETED
  FAILED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TaxCountry {
  NIGERIA
  US
  UK
  CANADA
  KENYA
  SOUTH_AFRICA
}

/// How a piece of income is taxed, which decides liabilities that differ by
/// source rather than by amount: UK Class 1 vs Class 4 National Insurance,
/// US self-employment tax, South African medical/retirement credits. Nullable so
/// historical rows are honestly "unclassified" instead of silently defaulting
/// into a rate table that would be wrong for them.
enum IncomeSource {
  EMPLOYMENT
  SELF_EMPLOYMENT
  INVESTMENT
  RENTAL
  OTHER
}

enum TaxChecklistStatus {
  READY
  OUTSTANDING
}

// TRIAL = inside the 14-day free trial, ACTIVE = paid subscriber,
// EXPIRED = trial lapsed with no active subscription (view-only).
enum PlanStatus {
  free
  trial
  pro
  past_due
  canceled
}

model User {
  clerkId                 String                  @id
  email                   String?
  firstName               String?
  lastName                String?
  imageUrl                String?
  /// The one status column. Everything that decides access reads this through
  /// `getEntitlement`, so there is no second place to keep in step.
  planStatus              PlanStatus              @default(free) @map("plan_status")
  // Null until the user starts their first Bachs card subscription. The trial
  // is tied to checkout, not to sign-up, so an account that never pays still has
  // its full week waiting for it.
  trialStartedAt          DateTime?
  /// Stored, not derived from trialStartedAt + a constant: changing the length
  /// must not silently move a window a user is already inside.
  trialEndsAt             DateTime?              @map("trial_ends_at")
  /// Set once the first-import summary has gone. Doubles as the idempotency
  /// key: a second import must never send it again, and a second sweep of the
  /// job must not send it twice.
  firstImportSummarySentAt DateTime?
  /// Bumped on any authenticated request, throttled to once every ten minutes.
  /// Every "is this person still around" question is measured from here rather
  /// than from the last transaction's date, which cannot tell a dormant
  /// account from one that has been reading and not acting.
  lastActiveAt           DateTime?               @map("last_active_at")
  /// IANA zone, used for the nudge send window and for "the 2nd of the month".
  timezone               String?                  @default("Africa/Lagos")
  /// Notification preferences. Default on: a product that starts silent about
  /// what it sends is worse than one that has to be turned off deliberately.
  nudgeEmailsEnabled     Boolean                  @default(true) @map("nudge_emails_enabled")
  nudgeInAppEnabled      Boolean                  @default(true) @map("nudge_in_app_enabled")
  bachsCustomerId         String?                 @unique
  bachsSubscriptionId     String?                 @unique
  bachsSubscriptionStatus String?
  /// The saved card (`pm_`) from a checkout created with `save_payment_method`.
  /// Present only for people who paid by card; somebody who paid by transfer or
  /// crypto has nothing saved, which is exactly why their access stops instead
  /// of renewing. Null is the normal state for a non-card payer, not an error.
  bachsPaymentMethodId    String?
  /// Whether we bill this account ourselves each period from the saved card.
  /// Off for anyone still on a Bachs subscription, who is renewed by Bachs and
  /// must not also be charged here.
  bachsRecurring          Boolean                 @default(false)
  /// When the saved card is next due to be charged. Null means never.
  bachsNextChargeAt       DateTime?
  /// What the saved card is billed in and how often, so a renewal does not have
  /// to guess at the customer's original choice.
  bachsChargeCurrency     String                  @default("USD")
  bachsChargeInterval     String                  @default("month")
  bachsChargeAmount       Decimal?                @db.Decimal(19, 4)
  bachsTrialEnd           DateTime?
  bachsCurrentPeriodEnd   DateTime?
  bachsCancelAtPeriodEnd  Boolean                 @default(false)
  planExpiresAt           DateTime?
  onboardedAt             DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  profile                 Profile?
  taxProfile              TaxProfile?
  accounts                Account[]
  wallets                 WalletAccount[]
  transactions            Transaction[]
  imports                 TransactionImport[]
  reviewItems             TransactionReviewItem[]
  categories              Category[]
  categorizationRules     CategorizationRule[]
  budgets                 Budget[]
  goals                   Goal[]
  goalContributions       GoalContribution[]
  integrationConnections  IntegrationConnection[]
  auditEvents             AuditEvent[]
  emailSyncJobs           EmailSyncJob[]
  emailImports            EmailImport[]
  reminderLogs            ReminderLog[]
  nudgeLogs               NudgeLog[]
  payments                Payment[]

  @@index([email])
  @@index([planStatus])
  @@index([trialEndsAt])
  @@index([firstImportSummarySentAt])
  @@index([lastActiveAt])
  @@index([nudgeEmailsEnabled])
  @@index([nudgeInAppEnabled])
}

model Profile {
  clerkId         String   @id
  currency        String   @default("USD")
  country         String?
  taxJurisdiction String?
  theme           String?
  accentColor     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [clerkId], references: [clerkId], onDelete: Cascade)
}

model TaxProfile {
  id                 String             @id @default(cuid())
  ownerClerkId       String             @unique
  country            TaxCountry         @default(NIGERIA)
  taxYear            Int
  estimatedTaxOwed   Decimal            @default(0) @db.Decimal(19, 4)
  taxableIncome      Decimal            @default(0) @db.Decimal(19, 4)
  deductionsCaptured Json?
  /// Jurisdiction-specific switches the tax module needs but no other feature uses:
  /// "resident"/"non-resident" (Kenya has a separate non-resident table), a region
  /// flag (Scotland uses different UK income tax bands), and an age band. Stored as
  /// a band rather than a date of birth because SARS rebates are all we need from it
  /// and it avoids collecting a DOB the product has no other use for.
  residencyStatus    String?
  region             String?
  ageBand            String?
  lastCalculatedAt   DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  owner              User               @relation(fields: [ownerClerkId], references: [clerkId], onDelete: Cascade)
  checklistItems     TaxChecklistItem[]
}

model TaxChecklistItem {
  id           String             @id @default(cuid())
  taxProfileId String
  /// Each jurisdiction has its own filing checklist, so items are scoped to the
  /// country that owns them. Switching jurisdiction must not discard progress on
  /// the previous one — a UK user researching Kenya and switching back has still
  /// done the UK work.
  country      TaxCountry
  key          String
  label        String
  status       TaxChecklistStatus @default(OUTSTANDING)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  taxProfile   TaxProfile         @relation(fields: [taxProfileId], references: [id], onDelete: Cascade)

  @@unique([taxProfileId, country, key])
  @@index([taxProfileId, country, status])
}

/**
 * One row per reminder email actually sent — filing-deadline marks (30/14/7/1
 * days before, -1 for the one-time overdue notice) and monthly digests. The
 * unique key is the dedupe: a daily job re-checks without re-sending.
 */
/**
 * Every nudge sent, in-app or by email, with its whole life in one row.
 *
 * Doubles as the idempotency record. `clickedAt`/`completedAt`/`dismissedAt` are
 * set afterwards by the client's callbacks, which is what lets a rule ask
 * "did they ignore this last time?" without keeping any state in memory — and
 * survives a restart, unlike a cache.
 */
model NudgeLog {
  id           String   @id @default(cuid())
  ownerClerkId String
  /** The rule's key, matching the entry in the nudge config. */
  nudgeKey     String
  /** "email" or "in_app". A nudge sent on both writes one row per channel. */
  channel      String
  sentAt       DateTime @default(now())
  clickedAt    DateTime?
  completedAt  DateTime?
  dismissedAt  DateTime?
  /** Marks a locally-shown in-app nudge the user swiped away, not acted on. */
  shownAt      DateTime?
  owner        User     @relation(fields: [ownerClerkId], references: [clerkId], onDelete: Cascade)

  @@index([ownerClerkId, nudgeKey, channel])
  @@index([ownerClerkId, sentAt])
  @@index([nudgeKey, sentAt])
}

model ReminderLog {
  id           String   @id @default(cuid())
  ownerClerkId String
  kind         String
  taxYear      Int
  daysBefore   Int
  sentAt       DateTime @default(now())
  owner        User     @relation(fields: [ownerClerkId], references: [clerkId], onDelete: Cascade)

  @@unique([ownerClerkId, kind, taxYear, daysBefore])
  @@index([ownerClerkId, kind])
}

/**
 * One-time Pro purchases. Bachs subscriptions live on the User row; these rows
 * are the audit trail plus the idempotency key (txRef) shared by checkout,
 * verify, and webhook fulfillment.
 *
 * Originally Flutterwave/NGN only, so `provider` and the nullable `providerTxId`
 * stay: a Bachs one-time purchase is `provider: "bachs"` with the charge id in
 * `providerTxId`, and the uniqueness that stops a replayed webhook granting a
 * second month is on (provider, providerTxId).
 */
model Payment {
  id           String    @id @default(cuid())
  ownerClerkId String
  provider     String    @default("flutterwave")
  txRef        String    @unique
  providerTxId String?
  /**
   * The Bachs checkout session this order was opened from.
   *
   * Its own column rather than sharing `providerTxId`: a `chk_` id is a
   * checkout and a `ch_` id is a charge, and conflating them would make the
   * charge-id uniqueness guard that stops a replayed webhook from granting a
   * second month depend on which half of the payment happened to arrive first.
   */
  checkoutId    String?
  plan         String // "month" | "year" | "once"
  amount       Decimal   @db.Decimal(19, 4)
  currency     String    @default("NGN")
  status       String    @default("pending") // pending | paid | underpaid | refunded | failed
  paidAt       DateTime?
  periodEndsAt DateTime?
  /// Months this purchase bought. One for a single "Pay once"; the column exists
  /// so applying access is arithmetic rather than a branch on which button was hit.
  months       Int       @default(1)
  /// How far short a crypto payment landed, in `currency`. Set on `underpaid`,
  /// which grants nothing — it is here so the Plan page can say what is owed
  /// without re-deriving it from the original charge.
  shortfall    Decimal?  @db.Decimal(19, 4)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  owner        User      @relation(fields: [ownerClerkId], references: [clerkId], onDelete: Cascade)

  @@unique([provider, providerTxId])
  @@index([checkoutId])
  @@index([ownerClerkId, status])
  @@index([providerTxId])
  @@index([periodEndsAt])
}

/**
 * Every webhook delivery, kept before it is acted on.
 *
 * `eventId` is unique and is the whole reason this table exists: Bachs retries
 * anything it does not get a 2xx for, and `collection.succeeded` and
 * `checkout.completed` both describe the same single payment. Fulfilment is
 * written as an insert-or-ignore against this row, so a duplicate delivery
 * loses the race and returns before it can grant a second month of Pro.
 *
 * `processedAt` is left null when the handler did not finish, which makes an
 * interrupted run visible afterwards instead of silently absent.
 */
model WebhookEvent {
  id          String    @id @default(cuid())
  eventId     String    @unique
  type        String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
}

model Account {
  id           String        @id @default(cuid())
  ownerClerkId String
  name         String
  type         AccountType
  institution  String?
  currency     String        @default("USD")
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  owner        User          @relation(fields: [ownerClerkId], references: [clerkId], onDelete: Cascade)
  transactions Transaction[]

  @@index([ownerClerkId, isActive])
}

model WalletAccount {
  id               String                 @id @default(cuid())
  ownerClerkId     String
  chain            Chain
  address          String
  displayName      String
  color            String
  isActive         Boolean                @default(true)
  isDefault        Boolean                @default(false)
  validationStatus WalletValidationStatus @default(PENDING)
  verifiedAt       DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  owner            User                   @relation(fields: [ownerClerkId], references: [clerkId], onDelete: Cascade)

  @@unique([ownerClerkId, chain, address])
  @@index([ownerClerkId, isActive])
}

model Category {
  id                  String               @id @default(cuid())
  ownerClerkId        String
  name                String
  color               String?
  isTaxable           Boolean              @default(false)
  isArchived          Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  owner               User                 @relation(fields: [ownerClerkId], references: [clerkId], onDelete: Cascade)
  transactions        Transaction[]
  categorizationRules CategorizationRule[]
  budgets             Budget[]

  @@unique([ownerClerkId, name])
  @@index([ownerClerkId, isArchived])
}

enum BudgetType {
  FIXED
  PERCENTAGE
}

model Budget {
  id           String     @id @default(cuid())
  ownerClerkId String
  categoryId   String
  type         BudgetType
  value        Decimal    @db.Decimal(19, 4)
  isExcluded   Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  owner        User       @relation(fields: [ownerClerkId], references: [clerkId], onDelete: Cascade)
  category     Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([ownerClerkId, categoryId])
  @@index([ownerClerkId, isExcluded])
}

enum GoalStatus {
  ACTIVE
  ARCHIVED
}

model Goal {
  id            String             @id @default(cuid())
  ownerClerkId  String
  name          String
  targetAmount  Decimal            @db.Decimal(19, 4)
  currency      String             @default("USD")
  deadline      DateTime?
  status        GoalStatus         @default(ACTIVE)
  archivedAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  owner         User               @relation(fields: [ownerClerkId], references: [clerkId], onDelete: Cascade)
  contributions GoalContribution[]

  @@index([ownerClerkId, status, deadline])
}

model GoalContribution {
  id            String   @id @default(cuid())
  ownerClerkId  String
  goalId        String
  amount        Decimal  @db.Decimal(19, 4)
  contributedAt DateTime @default(now())
  note          String?
  createdAt     DateTime @default(now())
  owner         User     @relation(fields: [ownerClerkId], references: [clerkId], onDelete: Cascade)
  goal          Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([ownerClerkId, goalId, contributedAt])
}

model CategorizationRule {
  id           String    @id @default(cuid())
  ownerClerkId String
  matcher      String
  categoryId   String?
  isTaxable    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  owner        User      @relation(fields: [ownerClerkId], references: [clerkId], onDelete: Cascade)
  category     Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([ownerClerkId, matcher])
  @@index([ownerClerkId, categoryId])
}

model Transaction {
  id             String             @id @default(cuid())
  ownerClerkId   String
  accountId      String?
  categoryId     String?
  type           TransactionType
  amount         Decimal            @db.Decimal(19, 4)
  currency       String             @default("USD")
  description    String
  merchant       String?
  occurredAt     DateTime
  source         String?
  assetSymbol    String?
  externalId     String?
  fingerprint    String?
  isRecurring    Boolean            @default(false)
  /// Only INCOME carries a value. EXPENSE and TRANSFER are null by definition,
  /// and an ambiguous inflow stays null until the user answers. `taxableSource`
  /// records whether the answer came from the country's tax module or the user.
  isTaxable      Boolean?
  taxableSource  String?
  /// Cached verdict of taxTreatment(): "taxable" | "not_taxable" | "ask".
  taxTreatment   String?
  /// True once the user has edited this row. Every automated pass — rules
  /// re-apply, future re-categorisation — must skip these.
  userOverridden Boolean            @default(false)
  /// Bank transaction reference. The join key for transfer pairing; TEXT
  /// because real references carry leading zeros.
  reference      String?
  /// Which section of a multi-account statement this row came from.
  subAccount     String?
  /// Why a transfer verdict was reached: "reference" | "pattern" | "name".
  transferSource String?
  /// Which way the money went. A transfer has no INCOME/EXPENSE type to carry
  /// the sign, so without this the two legs of one movement are indistinguishable
  /// and net worth double-counts the whole amount as an outflow.
  transferDirection TransferDirection?
  incomeSource   IncomeSource?
  needsReview    Boolean            @default(false)
  metadata       Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  owner          User               @relation(fields: [ownerClerkId], references: [clerkId], onDelete: Cascade)
  account        Account?           @relation(fields: [accountId], references: [id], onDelete: SetNull)
  category       Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  import         TransactionImport? @relation(fields: [importId], references: [id], onDelete: SetNull)
  importId       String?

  @@index([ownerClerkId, occurredAt])
  @@index([ownerClerkId, categoryId, occurredAt])
  @@index([ownerClerkId, fingerprint])
  @@index([ownerClerkId, reference])
  @@index([ownerClerkId, transferDirection])
  @@index([ownerClerkId, userOverridden])
  @@index([importId])
}

model TransactionImport {
  id             String                  @id @default(cuid())
  ownerClerkId   String
  type           ImportType
  status         ImportStatus            @default(CREATED)
  objectKey      String?
  originalName   String?
  /// sha256 of the uploaded bytes. A statement already imported under this hash
  /// is recognised and skipped, which is what stops a re-upload from paying for
  /// a second extraction — the expensive part, and the part that runs into the
  /// provider's rate limit.
  contentHash    String?
  rowCount       Int?
  /// One entry per section when a single document carries several accounts,
  /// holding the totals the document itself declared.
  sectionSummary Json?
  /// Result of reconciling parsed rows against those declared totals. A section
  /// that does not reconcile must not import silently.
  checks         Json?
  errorMessage   String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  owner          User                    @relation(fields: [ownerClerkId], references: [clerkId], onDelete: Cascade)
  transactions   Transaction[]
  reviewItems    TransactionReviewItem[]

  @@index([ownerClerkId, status, createdAt])
  @@index([ownerClerkId, contentHash])
}

model TransactionReviewItem {
  id           String            @id @default(cuid())
  ownerClerkId String
  importId     String
  rowNumber    Int
  status       ReviewStatus      @default(PENDING)
  rawData      Json
  proposedData Json?
  fingerprint  String?
  /// Bank transaction reference — the pairing key for transfers. TEXT, because
  /// real references carry leading zeros and a numeric parse would drop them.
  reference    String?
  /// Section label when one statement carries several accounts.
  subAccount   String?
  /// Which way this leg of a transfer moved. Both legs are TRANSFER, so without
  /// this the pair is indistinguishable until it reaches a transaction.
  transferDirection TransferDirection?
  confidence   Decimal?          @db.Decimal(5, 4)
  errorMessage String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  owner        User              @relation(fields: [ownerClerkId], references: [clerkId], onDelete: Cascade)
  import       TransactionImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([importId, rowNumber])
  @@index([ownerClerkId, status, createdAt])
}

model IntegrationConnection {
  id             String    @id @default(cuid())
  ownerClerkId   String
  provider       String
  status         String    @default("disconnected")
  providerUserId String?
  metadata       Json?
  lastSyncedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  owner          User      @relation(fields: [ownerClerkId], references: [clerkId], onDelete: Cascade)

  @@unique([ownerClerkId, provider])
}

/// One run of the email importer (Gmail/Outlook). Counts drive the UI summary.
model EmailSyncJob {
  id            String   @id @default(cuid())
  ownerClerkId  String
  provider      String
  status        String   @default("processing") // processing | completed | failed
  scanned       Int      @default(0)
  imported      Int      @default(0)
  /// Emails skipped because the same message or the same file was already imported.
  duplicates    Int      @default(0)
  /// Ledger rows flagged as duplicates of transactions that already exist.
  duplicateRows Int      @default(0)
  /// Emails that were not finance related or had no usable artifact.
  skipped       Int      @default(0)
  failed        Int      @default(0)
  errorMessage  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  owner         User     @relation(fields: [ownerClerkId], references: [clerkId], onDelete: Cascade)

  @@index([ownerClerkId, createdAt])
}

/// A single email artifact that has already been processed, used to make
/// re-syncs idempotent: the same message is never imported twice, and a
/// re-sent copy of the same file (same bytes) is reported as a duplicate.
model EmailImport {
  id           String    @id @default(cuid())
  ownerClerkId String
  provider     String
  messageId    String
  subject      String?
  fromAddress  String?
  receivedAt   DateTime?
  kind         String // statement | receipt | alert
  contentHash  String    @default("") // sha256 of the attachment bytes; "" for alert emails
  status       String // imported | duplicate | skipped | failed
  detail       String?
  importId     String?
  createdAt    DateTime  @default(now())
  owner        User      @relation(fields: [ownerClerkId], references: [clerkId], onDelete: Cascade)

  @@unique([ownerClerkId, provider, messageId])
  @@index([ownerClerkId, createdAt])
  @@index([ownerClerkId, contentHash])
}

/**
 * Global bank directory for the email importer — every Nigerian bank from
 * Paystack plus every active FDIC-insured US institution. Seeded from public
 * endpoints (no secrets); sender rules carry first-party evidence only.
 */
model Bank {
  id          String           @id @default(cuid())
  country     String // "NG" | "US"
  name        String
  slug        String?
  code        String? // NUBAN/NIBSS institution code (NG)
  longcode    String? // 9-digit branch sort code (NG)
  cert        String? // FDIC certificate number (US)
  city        String?
  state       String? // STALP (US)
  website     String? // FDIC WEBADDR or known corporate domain, for sender matching
  active      Boolean          @default(true)
  source      String // "paystack" | "fdic"
  sourceId    String? // Paystack id or FDIC CERT
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  senderRules BankSenderRule[]

  @@unique([source, sourceId])
  @@index([country, name])
  @@index([country, code])
}

model BankSenderRule {
  id        String   @id @default(cuid())
  bankId    String
  bank      Bank     @relation(fields: [bankId], references: [id], onDelete: Cascade)
  matchType String // "domain" (suffix of From address) | "exact" (full address) | "name" (bank-name keyword)
  pattern   String // lowercase: domain, address, or keyword
  verified  Boolean  @default(false) // true = first-party evidence (bank page or real email)
  createdAt DateTime @default(now())

  @@unique([bankId, matchType, pattern])
  @@index([matchType, pattern])
}

/**
 * Verified merchant/subscription senders (receipts, card charges).
 */
model MerchantRule {
  id        String   @id @default(cuid())
  merchant  String
  category  String?
  matchType String // "domain" | "exact" | "subject"
  pattern   String // lowercase
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([merchant, matchType, pattern])
  @@index([matchType, pattern])
}

model AuditEvent {
  id           String   @id @default(cuid())
  ownerClerkId String
  action       String
  entityType   String
  entityId     String?
  requestId    String?
  metadata     Json?
  createdAt    DateTime @default(now())
  owner        User     @relation(fields: [ownerClerkId], references: [clerkId], onDelete: Cascade)

  @@index([ownerClerkId, createdAt])
}
