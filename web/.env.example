NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# Absolute origin of the API. Defaults to the Railway deployment (see
# DEFAULT_API_ORIGIN in lib/api-client.ts), so this only needs setting to point
# at a different backend — a local API, or a staging one. Inlined at build time,
# so changing it requires a redeploy.
#
# Same-origin /v1/* and /health* requests are also proxied to Railway by
# next.config.ts, so the client works either way. Direct calls skip that hop.
# CORS allows the Vercel production origin and auth is a Clerk bearer token
# rather than a cookie, so cross-origin calls are fine.
NEXT_PUBLIC_API_URL=

# Error monitoring. With no DSN the SDK never initialises and the app behaves
# exactly as it does today. Everything sent is scrubbed in instrumentation-client.ts
# (identity off, query strings stripped, wallet addresses masked).
NEXT_PUBLIC_SENTRY_DSN=
# Only needed to upload source maps, which are what make a production stack
# trace readable. Without it Sentry runs in dry-run mode.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Product analytics. With no token, and before the visitor accepts, PostHog is
# never loaded — see lib/analytics.ts and components/analytics-consent-banner.tsx.
# Events carry feature usage and counts only, never financial values.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# Userback feedback widget (token from Userback dashboard → Project settings)
NEXT_PUBLIC_USERBACK_TOKEN=
